# Copy this file to app.env and fill in the real values on each environment.
# Do not commit app.env.

# MySQL on the CentOS host (the container uses host networking)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_NAME=cvonto_nurse_station

# Redis is optional for the current deployment
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Optional HIS interfaces
HIS_ENABLED=false
HIS_BASE_URL=
HIS_TIMEOUT=30
HIS_TOKEN=

HIS_WEBAPI_ENABLED=false
HIS_WEBAPI_BASE_URL=
HIS_WEBAPI_MESKEY=
HIS_WEBAPI_TIMEOUT=30
HIS_WEBAPI_USE_ENCRYPTION=false

# Queue callback security
QUEUE_CALLBACK_SECRET=CHANGE_ME
QUEUE_SIGN_VERIFY=false

# Application settings
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Barcode scanner settings
BARCODE_PREFIX=
BARCODE_LENGTH=0
SCANNER_AUTO_SUBMIT=true
